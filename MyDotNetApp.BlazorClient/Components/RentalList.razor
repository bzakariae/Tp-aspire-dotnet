@page "/rentals"
@inject HttpClient Http

<h2>Voitures disponibles</h2>

@if (cars == null)
{
    <p>Chargement...</p>
}
else if (!cars.Any())
{
    <p>Aucune voiture disponible actuellement.</p>
}
else
{
    <div class="cars-grid">
        @foreach (var car in cars)
        {
            <div class="car-card">
                <img src="@car.ImageUrl" alt="@car.Make" />
                <h3>@car.Make @car.Model</h3>
                <p>@car.Class</p>
                <p><strong>@car.PricePerDay € / jour</strong></p>
                <button @onclick="() => RentCar(car.Id)">Louer</button>
            </div>
        }
    </div>
}

@code {
    private List<Car>? cars;

    protected override async Task OnInitializedAsync()
    {
        cars = await Http.GetFromJsonAsync<List<Car>>("http://localhost:5222/renter/cars");
    }

    private void RentCar(int carId)
    {
        Navigation.NavigateTo($"/rent/{carId}");
    }

    [Inject] private NavigationManager? Navigation { get; set; }

    public class Car
    {
        public int Id { get; set; }
        public string Make { get; set; } = "";
        public string Model { get; set; } = "";
        public string Class { get; set; } = "";
        public decimal PricePerDay { get; set; }
        public string? ImageUrl { get; set; }
    }
}

<style>
.cars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
}
.car-card {
    background: white;
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    text-align: center;
}
.car-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 10px;
}
.car-card button {
    margin-top: 0.5rem;
    background: #0078d7;
    color: white;
    border: none;
    padding: 0.6rem 1rem;
    border-radius: 8px;
}
</style>
@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private List<Car> cars = new();
    private List<Rental> rentals = new();
    private List<Rental> pendingRentals = new();
    private AdminStats? stats;
    private bool isLoading = true;
    private bool showCarModal = false;
    private Car? editingCar;
    private bool showRejectModal = false;
    private Rental? rejectingRental;
    private string rejectReason = "";

    private bool showAdminModal = false;
    private string adminMessage = "";
    private RegisterUserRequest newAdmin = new();

  
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        if (!(user.Identity?.IsAuthenticated ?? false)) return;
        if (!user.IsInRole("ROLE_RENTAL_MANAGER")) return;

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            cars = await Http.GetFromJsonAsync<List<Car>>("api/admin/cars") ?? new();
            pendingRentals = await Http.GetFromJsonAsync<List<Rental>>("api/admin/rentals/rentals/pending") ?? new();
            stats = await Http.GetFromJsonAsync<AdminStats>("api/admin/rentals/stats");
            rentals = pendingRentals.ToList();
            rentals = await Http.GetFromJsonAsync<List<Rental>>("api/admin/rentals/rentals/all") ?? new();

            Console.WriteLine($" Loaded {cars.Count} cars, {pendingRentals.Count} pending rentals");
            Console.WriteLine($" Stats: TotalCars={stats?.TotalCars}, AvailableCars={stats?.AvailableCars}, TotalRentals={stats?.TotalRentals}, TotalRevenue={stats?.TotalRevenue}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($" Error loading data: {ex.Message}");
            Console.WriteLine($" Stack trace: {ex.StackTrace}");
        }
        finally
        {
            isLoading = false;
        }
    }

    [Inject] KeycloakAuthService Auth { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    private async Task HandleLogout()
    {
        if (await JS.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir vous déconnecter ?"))
            await Auth.LogoutAsync();
    }


    private void ShowAddCarModal()
    {
        editingCar = new Car { ImageUrl = "/placeholder.svg?height=300&width=400" };
        showCarModal = true;
    }

    private void EditCar(Car car)
    {
        editingCar = new Car
        {
            Id = car.Id,
            Make = car.Make,
            Model = car.Model,
            Class = car.Class,
            PricePerDay = car.PricePerDay,
            IsAvailable = car.IsAvailable,
            ImageUrl = car.ImageUrl
        };
        showCarModal = true;
    }
    private void ShowCreateAdminModal()
    {
        showAdminModal = true;
        adminMessage = "";
        newAdmin = new RegisterUserRequest();
    }

    private void CloseCreateAdminModal()
    {
        showAdminModal = false;
        newAdmin = new RegisterUserRequest();
        adminMessage = "";
    }

    @* Frontend-only admin creation (no backend call) *@
    private async Task CreateAdmin()
    {
        // Simulation frontend uniquement - pas d'appel API
        await Task.Delay(500); // Simule un délai de traitement
        
        if (string.IsNullOrWhiteSpace(newAdmin.Email) || 
            string.IsNullOrWhiteSpace(newAdmin.FullName) || 
            string.IsNullOrWhiteSpace(newAdmin.Password))
        {
            adminMessage = "Erreur : Tous les champs sont requis.";
            return;
        }

        // Validation simple de l'email
        if (!newAdmin.Email.Contains("@"))
        {
            adminMessage = "Erreur : Format d'email invalide.";
            return;
        }

        // Validation du mot de passe
        if (newAdmin.Password.Length < 6)
        {
            adminMessage = "Erreur : Le mot de passe doit contenir au moins 6 caractères.";
            return;
        }

        // Simulation de succès
        adminMessage = $"✓ Admin '{newAdmin.FullName}' créé avec succès !";
        
        // Réinitialiser le formulaire après 2 secondes
        await Task.Delay(2000);
        CloseCreateAdminModal();
    }


    private void CloseCarModal()
    {
        showCarModal = false;
        editingCar = null;
    }

    private async Task SaveCar()
    {
        if (editingCar == null) return;

        try
        {
            if (editingCar.Id > 0)
            {
                await Http.PutAsJsonAsync($"api/admin/cars/{editingCar.Id}", editingCar);
            }
            else
            {
                await Http.PostAsJsonAsync("api/admin/cars", editingCar);
            }

            await LoadData();
            CloseCarModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving car: {ex.Message}");
        }
    }

    private async Task DeleteCar(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer cette voiture ?"))
            return;

        try
        {
            await Http.DeleteAsync($"api/admin/cars/{id}");
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting car: {ex.Message}");
        }
    }

    private async Task ApproveRental(int rentalId)
    {
        try
        {
            var response = await Http.PostAsync($"api/admin/rentals/{rentalId}/approve", null);
            if (response.IsSuccessStatusCode)
            {
                await NotificationService.DeleteNotification(rentalId);
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error approving rental: {ex.Message}");
        }
    }

    private void ShowRejectModal(Rental rental)
    {
        rejectingRental = rental;
        rejectReason = "";
        showRejectModal = true;
    }

    private void CloseRejectModal()
    {
        showRejectModal = false;
        rejectingRental = null;
        rejectReason = "";
    }

    private async Task ConfirmReject()
    {
        if (rejectingRental == null) return;

        try
        {
            var response = await Http.PostAsJsonAsync($"api/admin/rentals/{rejectingRental.Id}/reject", new { Reason = rejectReason });
            if (response.IsSuccessStatusCode)
            {
                await NotificationService.DeleteNotification(rejectingRental.Id);
                CloseRejectModal();
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rejecting rental: {ex.Message}");
        }
    }

    private string GetStatusText(RentalStatus status)
    {
        return status switch
        {
            RentalStatus.Pending => "En attente",
            RentalStatus.Approved => "Approuvée",
            RentalStatus.Rejected => "Refusée",
            _ => "Inconnu"
        };
    }

    public class AdminStats
    {
        public int TotalRentals { get; set; }
        public decimal TotalRevenue { get; set; }
        public int AvailableCars { get; set; }
        public int TotalCars { get; set; }
    }
    public class RegisterUserRequest
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string FullName { get; set; } = "";
    }
}

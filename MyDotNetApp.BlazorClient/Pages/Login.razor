@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims;

@page "/login"
@inject NavigationManager Navigation
@inject KeycloakAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
<div class="login-experience">
    <canvas id="particles-canvas" class="particles-bg"></canvas>
    
    <div class="gradient-mesh">
        <div class="mesh-gradient mesh-1"></div>
        <div class="mesh-gradient mesh-2"></div>
        <div class="mesh-gradient mesh-3"></div>
        <div class="mesh-gradient mesh-4"></div>
    </div>

    <div class="login-container">
        <div class="brand-panel">
            <div class="brand-content">
                <div class="brand-logo">
                    <div class="logo-ring ring-1"></div>
                    <div class="logo-ring ring-2"></div>
                    <div class="logo-ring ring-3"></div>
                    <div class="logo-core">
                        <img src="logo.png" alt="FuegoCars Logo" class="fuegocars-logo" />
                    </div>
                </div>

                <h1 class="brand-title">
                    <span class="title-word" style="--delay: 0"> ⭐ ⭐ ⭐ </span>
                    <span class="title-word" style="--delay: 1">FuegoCars</span>
          
                </h1>
                
             

                <div class="feature-badges">
                    <div class="feature-badge">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                        <span>Sécurisé</span>
                    </div>
                    <div class="feature-badge">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                        </svg>
                        <span>Rapide</span>
                    </div>
                    <div class="feature-badge">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 6v6l4 2"/>
                        </svg>
                        <span>24/7</span>
                    </div>
                </div>

                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-value">10K+</div>
                        <div class="stat-label">Utilisateurs</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">99.9%</div>
                        <div class="stat-label">Disponibilité</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">0 </div>
                        <div class="stat-label">interruption</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-panel">
            <div class="form-wrapper">
                <div class="form-header">
                    <div class="tab-selector">
                        <button class="tab-btn @(!showAdminForm ? "active" : "")" 
                                @onclick="() => showAdminForm = false">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            <span>Se connecter</span>
                        </button>
                        <button class="tab-btn @(showAdminForm ? "active" : "")" 
                                @onclick="() => showAdminForm = true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
                                <path d="M8.5 8.5v.01"/>
                                <path d="M16 15.5v.01"/>
                            </svg>
                            <span>Inscription</span>
                        </button>
                        <div class="tab-indicator" style="transform: translateX(@(showAdminForm ? "100%" : "0"))"></div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="notification error-notification">
                        <div class="notification-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                        </div>
                        <div class="notification-content">
                            <div class="notification-title">Erreur de connexion</div>
                            <div class="notification-message">@errorMessage</div>
                        </div>
                        <button class="notification-close" @onclick="() => errorMessage = null">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"/>
                                <line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        </button>
                    </div>
                }

               <div class="form-content">
    @if (!showAdminForm)
{
    <div class="login-section">
        <h2 class="section-title">Mon compte FuegoCars</h2>
        <p class="section-subtitle">Accédez à votre espace personnel</p>

        <div class="modern-form">
            <div class="input-group">
                <label class="input-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                        <polyline points="22,6 12,13 2,6"/>
                    </svg>
                    <span>Adresse email</span>
                </label>
                <div class="input-wrapper">
                    <input type="email"
                           class="modern-input"
                           placeholder="utilisateur@example.com"
                           @bind="userEmail"
                           @bind:event="oninput"
                           disabled="@isLoading"
                           autocomplete="email"
                           required/>
                    <div class="input-border"></div>
                </div>
            </div>

            <div class="input-group">
                <label class="input-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    <span>Mot de passe</span>
                </label>
                <div class="input-wrapper">
                    <input type="password"
                           class="modern-input"
                           placeholder="••••••••••"
                           @bind="userPassword"
                           @bind:event="oninput"
                           disabled="@isLoading"
                           autocomplete="current-password"
                           required/>
                    <div class="input-border"></div>
                </div>
            </div>

            <div class="form-options">
                <label class="checkbox-label">
                    <input type="checkbox" class="modern-checkbox"/>
                    <span class="checkbox-custom"></span>
                    <span>Se souvenir de moi</span>
                </label>
                <a href="#" class="link-text">Mot de passe oublié ?</a>
            </div>

            <button type="button" class="submit-btn" @onclick="LoginUser" disabled="@isLoading">
                <div class="submit-btn-bg"></div>
                <div class="submit-btn-content">
                    @if (isLoading)
                    {
                        <div class="loader-ring">
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                        <span>Connexion...</span>
                    }
                    else
                    {
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                            <polyline points="10 17 15 12 10 7"/>
                            <line x1="15" y1="12" x2="3" y2="12"/>
                        </svg>
                        <span>Se connecter</span>
                    }
                </div>
            </button>
        </div>

        <div class="security-info">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
            </svg>
            <span>Connexion sécurisée</span>
        </div>
    </div>
}
   else
{
    <div class="login-section user-registration-section">
        <h2 class="section-title">Créer un compte</h2>
        <p class="section-subtitle">Rejoignez-nous et profitez de nos services</p>

        <div class="modern-form">
            <div class="input-group">
                <label class="input-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
                    </svg>
                    <span>Prénom</span>
                </label>
                <div class="input-wrapper">
                    <input type="text"
                           class="modern-input"
                           placeholder="Votre prénom"
                           @bind="userFirstName"
                           @bind:event="oninput"
                           required />
                    <div class="input-border"></div>
                </div>
            </div>

            <div class="input-group">
                <label class="input-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
                    </svg>
                    <span>Nom</span>
                </label>
                <div class="input-wrapper">
                    <input type="text"
                           class="modern-input"
                           placeholder="Votre nom"
                           @bind="userLastName"
                           @bind:event="oninput"
                           required />
                    <div class="input-border"></div>
                </div>
            </div>

            <div class="input-group">
                <label class="input-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                        <polyline points="22,6 12,13 2,6"/>
                    </svg>
                    <span>Adresse email</span>
                </label>
                <div class="input-wrapper">
                    <input type="email"
                           class="modern-input"
                           placeholder="utilisateur@example.com"
                           @bind="userEmail"
                           @bind:event="oninput"
                           required />
                    <div class="input-border"></div>
                </div>
            </div>

            <div class="input-group">
                <label class="input-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    <span>Mot de passe</span>
                </label>
                <div class="input-wrapper">
                    <input type="password"
                           class="modern-input"
                           placeholder="••••••••••"
                           @bind="userPassword"
                           @bind:event="oninput"
                           required />
                    <div class="input-border"></div>
                </div>
            </div>

            <button type="button" class="submit-btn" @onclick="RegisterUser">
                <div class="submit-btn-bg"></div>
                <div class="submit-btn-content">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    <span>Créer un compte</span>
                </div>
            </button>
        </div>
    </div>
}

</div>

                <div class="form-footer">
                    <div class="footer-links">
                        <a href="#" class="footer-link">Politique de confidentialité</a>
                        <span class="footer-separator">•</span>
                        <a href="#" class="footer-link">Conditions d'utilisation</a>
                        <span class="footer-separator">•</span>
                        <a href="#" class="footer-link">Support</a>
                    </div>
                    <div class="footer-copyright">
                        © 2025 FuegoCars. Tous droits réservés.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #6366f1;
        --primary-light: #818cf8;
        --primary-dark: #4f46e5;
        --secondary: #ec4899;
        --success: #10b981;
        --error: #ef4444;
        --warning: #f59e0b;
        
        --bg-dark: #0a0a0f;
        --bg-darker: #050508;
        --surface: rgba(255, 255, 255, 0.03);
        --surface-hover: rgba(255, 255, 255, 0.06);
        
        --text-primary: #ffffff;
        --text-secondary: rgba(255, 255, 255, 0.7);
        --text-tertiary: rgba(255, 255, 255, 0.4);
        
        --border: rgba(255, 255, 255, 0.08);
        --border-hover: rgba(255, 255, 255, 0.15);
        
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.2);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.3);
        --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.4);
        --shadow-xl: 0 12px 48px rgba(0, 0, 0, 0.5);
        
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 24px;
        
        --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-base: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    .fuegocars-logo {
        width: 120px;      
        height: auto;
        border-radius: 20px; 
        filter: drop-shadow(0 0 8px rgba(255, 90, 0, 0.6));
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    .fuegocars-logo:hover {
        transform: scale(1.05);
        filter: drop-shadow(0 0 15px rgba(255, 120, 0, 0.8));
    }
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .login-experience {
        min-height: 100vh;
        background: var(--bg-dark);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .particles-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .gradient-mesh {
        position: absolute;
        inset: 0;
        overflow: hidden;
        opacity: 0.6;
    }

    .mesh-gradient {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        animation: meshFloat 25s infinite ease-in-out;
    }

    .mesh-1 {
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.4) 0%, transparent 70%);
        top: -300px;
        left: -200px;
        animation-delay: 0s;
    }

    .mesh-2 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(236, 72, 153, 0.3) 0%, transparent 70%);
        bottom: -250px;
        right: -150px;
        animation-delay: 8s;
    }

    .mesh-3 {
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.25) 0%, transparent 70%);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation-delay: 16s;
    }

    .mesh-4 {
        width: 550px;
        height: 550px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.2) 0%, transparent 70%);
        top: 20%;
        right: 10%;
        animation-delay: 12s;
    }

    @@keyframes meshFloat {
        0%, 100% { 
            transform: translate(0, 0) scale(1);
            opacity: 0.6;
        }
        25% { 
            transform: translate(50px, -50px) scale(1.1);
            opacity: 0.8;
        }
        50% { 
            transform: translate(-30px, 30px) scale(0.95);
            opacity: 0.5;
        }
        75% { 
            transform: translate(40px, 40px) scale(1.05);
            opacity: 0.7;
        }
    }

    .login-container {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        width: 100%;
        max-width: 1400px;
        min-height: 800px;
        margin: 20px;
        background: rgba(15, 15, 25, 0.6);
        backdrop-filter: blur(40px);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow-xl);
        animation: containerAppear 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes containerAppear {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(20px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .brand-panel {
        background: linear-gradient(135deg, 
            rgba(99, 102, 241, 0.1) 0%, 
            rgba(236, 72, 153, 0.1) 100%);
        border-right: 1px solid var(--border);
        padding: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .brand-panel::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, 
            transparent 30%, 
            rgba(99, 102, 241, 0.05) 50%, 
            transparent 70%);
        animation: brandShine 10s infinite linear;
    }

    @@keyframes brandShine {
        0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
        100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
    }

    .brand-content {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 500px;
    }

    .brand-logo {
        position: relative;
        width: 160px;
        height: 160px;
        margin: 0 auto 48px;
    }

    .logo-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 2px solid;
        opacity: 0.2;
    }

    .logo-ring.ring-1 {
        border-color: var(--primary);
        animation: logoRing 4s infinite cubic-bezier(0.4, 0, 0.6, 1);
    }

    .logo-ring.ring-2 {
        border-color: var(--secondary);
        animation: logoRing 4s infinite cubic-bezier(0.4, 0, 0.6, 1);
        animation-delay: 1.3s;
    }

    .logo-ring.ring-3 {
        border-color: var(--success);
        animation: logoRing 4s infinite cubic-bezier(0.4, 0, 0.6, 1);
        animation-delay: 2.6s;
    }

    @@keyframes logoRing {
        0%, 100% {
            transform: scale(1);
            opacity: 0.2;
        }
        50% {
            transform: scale(1.3);
            opacity: 0;
        }
    }

    .logo-core {
        position: absolute;
        inset: 20px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 30%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 0 60px rgba(99, 102, 241, 0.5);
        animation: logoFloat 3s infinite ease-in-out;
    }

    @@keyframes logoFloat {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(5deg); }
    }

    .brand-title {
        font-size: 48px;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 16px;
        line-height: 1.2;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .title-word {
        display: inline-block;
        animation: titleAppear 0.8s cubic-bezier(0.16, 1, 0.3, 1) backwards;
        animation-delay: calc(var(--delay) * 0.15s);
    }

    @@keyframes titleAppear {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .brand-description {
        font-size: 16px;
        line-height: 1.6;
        color: var(--text-secondary);
        margin-bottom: 40px;
        animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s backwards;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .feature-badges {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-bottom: 48px;
        flex-wrap: wrap;
        animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s backwards;
    }

    .feature-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 100px;
        color: var(--text-secondary);
        font-size: 14px;
        font-weight: 500;
        transition: all var(--transition-base);
    }

    .feature-badge:hover {
        background: var(--surface-hover);
        border-color: var(--border-hover);
        transform: translateY(-2px);
    }

    .feature-badge svg {
        color: var(--primary-light);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s backwards;
    }

    .stat-item {
        text-align: center;
        padding: 20px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        transition: all var(--transition-base);
    }

    .stat-item:hover {
        background: var(--surface-hover);
        border-color: var(--border-hover);
        transform: translateY(-4px);
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 6px;
        background: linear-gradient(135deg, var(--primary-light), var(--secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stat-label {
        font-size: 13px;
        color: var(--text-tertiary);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-panel {
        padding: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(10, 10, 15, 0.4);
    }

    .form-wrapper {
        width: 100%;
        max-width: 480px;
        animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s backwards;
    }

    .form-header {
        margin-bottom: 40px;
    }

    .tab-selector {
        position: relative;
        display: grid;
        grid-template-columns: 1fr 1fr;

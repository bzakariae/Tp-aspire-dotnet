@page "/login"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject HttpClient Http
@using MyDotNetApp.BlazorClient.Models
@using MyDotNetApp.BlazorClient.Services

<div class="login-experience">
    <canvas id="particles-canvas" class="particles-bg"></canvas>
    
    <div class="gradient-mesh">
        <div class="mesh-gradient mesh-1"></div>
        <div class="mesh-gradient mesh-2"></div>
        <div class="mesh-gradient mesh-3"></div>
        <div class="mesh-gradient mesh-4"></div>
    </div>

    <div class="login-container">
        <div class="brand-panel">
            <div class="brand-content">
                <div class="brand-logo">
                    <div class="logo-ring ring-1"></div>
                    <div class="logo-ring ring-2"></div>
                    <div class="logo-ring ring-3"></div>
                    <div class="logo-core">
                        <img src="logo.png" alt="FuegoCars Logo" class="fuegocars-logo" />
                    </div>
                </div>

                <h1 class="brand-title">
                    <span class="title-word" style="--delay: 0"> ⭐ ⭐ ⭐ </span>
                    <span class="title-word" style="--delay: 1">FuegoCars</span>
          
                </h1>
                
             

                <div class="feature-badges">
                    <div class="feature-badge">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                        <span>Sécurisé</span>
                    </div>
                    <div class="feature-badge">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                        </svg>
                        <span>Rapide</span>
                    </div>
                    <div class="feature-badge">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 6v6l4 2"/>
                        </svg>
                        <span>24/7</span>
                    </div>
                </div>

                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-value">10K+</div>
                        <div class="stat-label">Utilisateurs</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">99.9%</div>
                        <div class="stat-label">Disponibilité</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">0 </div>
                        <div class="stat-label">interruption</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-panel">
            <div class="form-wrapper">
                <div class="form-header">
                    <div class="tab-selector">
                        <button class="tab-btn @(!showAdminForm ? "active" : "")" 
                                @onclick="() => showAdminForm = false">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            <span>Utilisateur</span>
                        </button>
                        <button class="tab-btn @(showAdminForm ? "active" : "")" 
                                @onclick="() => showAdminForm = true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
                                <path d="M8.5 8.5v.01"/>
                                <path d="M16 15.5v.01"/>
                            </svg>
                            <span>Admin</span>
                        </button>
                        <div class="tab-indicator" style="transform: translateX(@(showAdminForm ? "100%" : "0"))"></div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="notification error-notification">
                        <div class="notification-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                        </div>
                        <div class="notification-content">
                            <div class="notification-title">Erreur de connexion</div>
                            <div class="notification-message">@errorMessage</div>
                        </div>
                        <button class="notification-close" @onclick="() => errorMessage = null">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"/>
                                <line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        </button>
                    </div>
                }

                <div class="form-content">
                    @if (!showAdminForm)
                    {
                        <div class="login-section">
                            <h2 class="section-title">Connexion rapide</h2>
                            <p class="section-subtitle">Choisissez votre méthode de connexion</p>

                            <div class="oauth-providers">
                                <button class="oauth-btn discord-btn" @onclick="HandleDiscordLogin" disabled="@isLoading">
                                    <div class="oauth-btn-bg"></div>
                                    <div class="oauth-btn-content">
                                        @if (isLoading)
                                        {
                                            <div class="loader-ring">
                                                <div></div>
                                                <div></div>
                                                <div></div>
                                            </div>
                                            <span>Connexion...</span>
                                        }
                                        else
                                        {
                                            <svg width="24" height="24" viewBox="0 0 71 55" fill="currentColor">
                                                <path d="M60.1045 4.8978C55.5792 2.8214 50.7265 1.2916 45.6527 0.41542C45.5603 0.39851 45.468 0.440769 45.4204 0.525289C44.7963 1.6353 44.105 3.0834 43.6209 4.2216C38.1637 3.4046 32.7345 3.4046 27.3892 4.2216C26.905 3.0581 26.1886 1.6353 25.5617 0.525289C25.5141 0.443589 25.4218 0.40133 25.3294 0.41542C20.2584 1.2888 15.4057 2.8186 10.8776 4.8978C10.8384 4.9147 10.8048 4.9429 10.7825 4.9795C1.57795 18.7309 -0.943561 32.1443 0.293408 45.3914C0.299005 45.4562 0.335386 45.5182 0.385761 45.5576C6.45866 50.0174 12.3413 52.7249 18.1147 54.5195C18.2071 54.5477 18.305 54.5139 18.3638 54.4378C19.7295 52.5728 20.9469 50.6063 21.9907 48.5383C22.0523 48.4172 21.9935 48.2735 21.8676 48.2256C19.9366 47.4931 18.0979 46.6 16.3292 45.5858C16.1893 45.5041 16.1781 45.304 16.3068 45.2082C16.679 44.9293 17.0513 44.6391 17.4067 44.3461C17.471 44.2926 17.5606 44.2813 17.6362 44.3151C29.2558 49.6202 41.8354 49.6202 53.3179 44.3151C53.3935 44.2785 53.4831 44.2898 53.5502 44.3433C53.9057 44.6363 54.2779 44.9293 54.6529 45.2082C54.7816 45.304 54.7732 45.5041 54.6333 45.5858C52.8646 46.6197 51.0259 47.4931 49.0921 48.2228C48.9662 48.2707 48.9102 48.4172 48.9718 48.5383C50.038 50.6034 51.2554 52.5699 52.5959 54.435C52.6519 54.5139 52.7526 54.5477 52.845 54.5195C58.6464 52.7249 64.529 50.0174 70.6019 45.5576C70.6551 45.5182 70.6887 45.459 70.6943 45.3942C72.1747 30.0791 68.2147 16.7757 60.1968 4.9823C60.1772 4.9429 60.1437 4.9147 60.1045 4.8978ZM23.7259 37.3253C20.2276 37.3253 17.3451 34.1136 17.3451 30.1693C17.3451 26.225 20.1717 23.0133 23.7259 23.0133C27.308 23.0133 30.1626 26.2532 30.1066 30.1693C30.1066 34.1136 27.28 37.3253 23.7259 37.3253ZM47.3178 37.3253C43.8196 37.3253 40.9371 34.1136 40.9371 30.1693C40.9371 26.225 43.7636 23.0133 47.3178 23.0133C50.9 23.0133 53.7545 26.2532 53.6986 30.1693C53.6986 34.1136 50.9 37.3253 47.3178 37.3253Z"/>
                                            </svg>
                                            <span>Continuer avec Discord</span>
                                            <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="5" y1="12" x2="19" y2="12"/>
                                                <polyline points="12 5 19 12 12 19"/>
                                            </svg>
                                        }
                                    </div>
                                </button>

                                <div class="oauth-grid">
                                    <button class="oauth-mini-btn" title="Google (bientôt disponible)" disabled>
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                                        </svg>
                                    </button>
                                    <button class="oauth-mini-btn" title="Facebook (bientôt disponible)" disabled>
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M22.675 0h-21.35C.597 0 0 .597 0 1.325v21.351C0 23.403.597 24 1.325 24h11.495v-9.294H9.691v-3.622h3.129V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.464.099 2.796.143v3.243l-1.919.001c-1.504 0-1.795.715-1.795 1.763v2.311h3.587l-.467 3.622h-3.12V24h6.116C23.403 24 24 23.403 24 22.676V1.325C24 .597 23.403 0 22.675 0z"/>
                                        </svg>
                                    </button>

                                    <button class="oauth-mini-btn" title="Microsoft (bientôt disponible)" disabled>
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z" fill="#00A4EF"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="login-section admin-section">
                            <h2 class="section-title">Espace Administrateur</h2>
                            <p class="section-subtitle">Accès sécurisé réservé aux administrateurs</p>

                            <form class="modern-form" @onsubmit="HandleAdminLogin" @onsubmit:preventDefault>
                                <div class="input-group">
                                    <label class="input-label">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                            <polyline points="22,6 12,13 2,6"/>
                                        </svg>
                                        <span>Adresse email</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <input type="email" 
                                               class="modern-input" 
                                               placeholder="admin@example.com" 
                                               @bind="adminEmail"
                                               @bind:event="oninput"
                                               disabled="@isAdminLoading"
                                               autocomplete="email"
                                               required />
                                        <div class="input-border"></div>
                                    </div>
                                </div>

                                <div class="input-group">
                                    <label class="input-label">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                        </svg>
                                        <span>Mot de passe</span>
                                    </label>
                                    <div class="input-wrapper">
                                        <input type="password" 
                                               class="modern-input" 
                                               placeholder="••••••••••" 
                                               @bind="adminPassword"
                                               @bind:event="oninput"
                                               disabled="@isAdminLoading"
                                               autocomplete="current-password"
                                               required />
                                        <div class="input-border"></div>
                                    </div>
                                </div>

                                <div class="form-options">
                                    <label class="checkbox-label">
                                        <input type="checkbox" class="modern-checkbox" />
                                        <span class="checkbox-custom"></span>
                                        <span>Se souvenir de moi</span>
                                    </label>
                                    <a href="#" class="link-text">Mot de passe oublié ?</a>
                                </div>

                                <button type="submit" class="submit-btn" disabled="@isAdminLoading">
                                    <div class="submit-btn-bg"></div>
                                    <div class="submit-btn-content">
                                        @if (isAdminLoading)
                                        {
                                            <div class="loader-ring">
                                                <div></div>
                                                <div></div>
                                                <div></div>
                                            </div>
                                            <span>Vérification...</span>
                                        }
                                        else
                                        {
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                                                <polyline points="10 17 15 12 10 7"/>
                                                <line x1="15" y1="12" x2="3" y2="12"/>
                                            </svg>
                                            <span>Se connecter</span>
                                        }
                                    </div>
                                </button>
                            </form>

                            <div class="security-info">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    <path d="M9 12l2 2 4-4"/>
                                </svg>
                                <span>Connexion protégée par chiffrement de bout en bout</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="form-footer">
                    <div class="footer-links">
                        <a href="#" class="footer-link">Politique de confidentialité</a>
                        <span class="footer-separator">•</span>
                        <a href="#" class="footer-link">Conditions d'utilisation</a>
                        <span class="footer-separator">•</span>
                        <a href="#" class="footer-link">Support</a>
                    </div>
                    <div class="footer-copyright">
                        © 2025 FuegoCars. Tous droits réservés.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #6366f1;
        --primary-light: #818cf8;
        --primary-dark: #4f46e5;
        --secondary: #ec4899;
        --success: #10b981;
        --error: #ef4444;
        --warning: #f59e0b;
        
        --bg-dark: #0a0a0f;
        --bg-darker: #050508;
        --surface: rgba(255, 255, 255, 0.03);
        --surface-hover: rgba(255, 255, 255, 0.06);
        
        --text-primary: #ffffff;
        --text-secondary: rgba(255, 255, 255, 0.7);
        --text-tertiary: rgba(255, 255, 255, 0.4);
        
        --border: rgba(255, 255, 255, 0.08);
        --border-hover: rgba(255, 255, 255, 0.15);
        
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.2);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.3);
        --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.4);
        --shadow-xl: 0 12px 48px rgba(0, 0, 0, 0.5);
        
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 24px;
        
        --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-base: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    .fuegocars-logo {
        width: 120px;      
        height: auto;
        border-radius: 20px; 
        filter: drop-shadow(0 0 8px rgba(255, 90, 0, 0.6));
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    .fuegocars-logo:hover {
        transform: scale(1.05);
        filter: drop-shadow(0 0 15px rgba(255, 120, 0, 0.8));
    }
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .login-experience {
        min-height: 100vh;
        background: var(--bg-dark);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .particles-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .gradient-mesh {
        position: absolute;
        inset: 0;
        overflow: hidden;
        opacity: 0.6;
    }

    .mesh-gradient {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        animation: meshFloat 25s infinite ease-in-out;
    }

    .mesh-1 {
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.4) 0%, transparent 70%);
        top: -300px;
        left: -200px;
        animation-delay: 0s;
    }

    .mesh-2 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(236, 72, 153, 0.3) 0%, transparent 70%);
        bottom: -250px;
        right: -150px;
        animation-delay: 8s;
    }

    .mesh-3 {
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.25) 0%, transparent 70%);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation-delay: 16s;
    }

    .mesh-4 {
        width: 550px;
        height: 550px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.2) 0%, transparent 70%);
        top: 20%;
        right: 10%;
        animation-delay: 12s;
    }

    @@keyframes meshFloat {
        0%, 100% { 
            transform: translate(0, 0) scale(1);
            opacity: 0.6;
        }
        25% { 
            transform: translate(50px, -50px) scale(1.1);
            opacity: 0.8;
        }
        50% { 
            transform: translate(-30px, 30px) scale(0.95);
            opacity: 0.5;
        }
        75% { 
            transform: translate(40px, 40px) scale(1.05);
            opacity: 0.7;
        }
    }

    .login-container {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        width: 100%;
        max-width: 1400px;
        min-height: 800px;
        margin: 20px;
        background: rgba(15, 15, 25, 0.6);
        backdrop-filter: blur(40px);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow-xl);
        animation: containerAppear 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes containerAppear {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(20px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .brand-panel {
        background: linear-gradient(135deg, 
            rgba(99, 102, 241, 0.1) 0%, 
            rgba(236, 72, 153, 0.1) 100%);
        border-right: 1px solid var(--border);
        padding: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .brand-panel::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, 
            transparent 30%, 
            rgba(99, 102, 241, 0.05) 50%, 
            transparent 70%);
        animation: brandShine 10s infinite linear;
    }

    @@keyframes brandShine {
        0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
        100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
    }

    .brand-content {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 500px;
    }

    .brand-logo {
        position: relative;
        width: 160px;
        height: 160px;
        margin: 0 auto 48px;
    }

    .logo-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 2px solid;
        opacity: 0.2;
    }

    .logo-ring.ring-1 {
        border-color: var(--primary);
        animation: logoRing 4s infinite cubic-bezier(0.4, 0, 0.6, 1);
    }

    .logo-ring.ring-2 {
        border-color: var(--secondary);
        animation: logoRing 4s infinite cubic-bezier(0.4, 0, 0.6, 1);
        animation-delay: 1.3s;
    }

    .logo-ring.ring-3 {
        border-color: var(--success);
        animation: logoRing 4s infinite cubic-bezier(0.4, 0, 0.6, 1);
        animation-delay: 2.6s;
    }

    @@keyframes logoRing {
        0%, 100% {
            transform: scale(1);
            opacity: 0.2;
        }
        50% {
            transform: scale(1.3);
            opacity: 0;
        }
    }

    .logo-core {
        position: absolute;
        inset: 20px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 30%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 0 60px rgba(99, 102, 241, 0.5);
        animation: logoFloat 3s infinite ease-in-out;
    }

    @@keyframes logoFloat {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(5deg); }
    }

    .brand-title {
        font-size: 48px;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 16px;
        line-height: 1.2;
        display: flex;
        flex-direction: column;

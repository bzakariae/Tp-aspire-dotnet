@code {
    private string? errorMessage;
    private bool isLoading = false;
    private bool isAdminLoading = false;
    private bool showAdminForm = false;
    private string adminEmail = "";
    private string adminPassword = "";

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
          
        }
    }

    private async Task HandleDiscordLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var authUrl = await AuthService.InitiateDiscordLogin();
            Navigation.NavigateTo(authUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = "Impossible de se connecter à Discord. Veuillez réessayer.";
            Console.WriteLine($"Discord login error: {ex.Message}");
            isLoading = false;
        }
    }

    private async Task HandleAdminLogin()
    {
        errorMessage = null;
        isAdminLoading = true;

        try
        {
            Console.WriteLine($"Attempting admin login for: {adminEmail}");
            
            var loginRequest = new Services.LoginRequest
            {
                Email = adminEmail,
                Password = adminPassword
            };

            var result = await AuthService.Login(loginRequest);

            if (result != null)
            {
                Console.WriteLine($"Admin login successful, role: {result.Role}");
                
                if (result.Role == "Admin")
                {
                    Navigation.NavigateTo("/admin", forceLoad: true);
                }
                else
                {
                    errorMessage = "Accès refusé. Seuls les administrateurs peuvent se connecter ici.";
                    isAdminLoading = false;
                }
            }
            else
            {
                errorMessage = "Identifiants incorrects. Veuillez vérifier votre email et mot de passe.";
                Console.WriteLine("Admin login failed: invalid credentials");
                isAdminLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erreur de connexion au serveur. Veuillez réessayer plus tard.";
            Console.WriteLine($"Admin login error: {ex.Message}");
            isAdminLoading = false;
        }
    }
}
@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private List<Car> availableCars = new();
    private List<Rental> myRentals = new();
    private bool isLoading = true;
    private string activeTab = "cars";
    private bool showRentalModal = false;
    private Car? selectedCar;
    private Rental rentalRequest = new();
    private DateTime startDate = DateTime.Today.AddDays(1);
    private DateTime endDate = DateTime.Today.AddDays(2);
    private decimal estimatedPrice = 0;
    private int estimatedDays = 0;
    private bool isSubmitting = false;
    private string? rentalError;
    private string? rentalSuccess;
    private string userName = string.Empty;
    private string searchQuery = "";
    private string filterClass = "";

    private List<Car> FilteredCars
    {
        get
        {
            var filtered = availableCars.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                filtered = filtered.Where(c =>
                    c.Make.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    c.Model.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(filterClass))
            {
                filtered = filtered.Where(c => c.Class == filterClass);
            }

            return filtered.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userName =
                user.Identity.Name
                ?? user.FindFirst("preferred_username")?.Value
                ?? user.FindFirst(ClaimTypes.Email)?.Value
                ?? "Utilisateur";
        }

        await LoadData();
    }



    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            availableCars = await Http.GetFromJsonAsync<List<Car>>("api/renter/cars") ?? new();
            myRentals = await Http.GetFromJsonAsync<List<Rental>>("api/renter/myrentals") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetUserInitials()
    {
        if (string.IsNullOrEmpty(userName)) return "U";
        var parts = userName.Split(' ');
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return userName.Substring(0, Math.Min(2, userName.Length)).ToUpper();
    }

    private void ShowRentalModal(Car car)
    {
        selectedCar = car;
        rentalRequest = new Rental
        {
            CarId = car.Id,
            RenterName = userName ?? "",
            StartDate = DateOnly.FromDateTime(startDate),
            EndDate = DateOnly.FromDateTime(endDate)
        };
        CalculatePrice();
        showRentalModal = true;
        rentalError = null;
        rentalSuccess = null;
    }

    private void CloseRentalModal()
    {
        showRentalModal = false;
        selectedCar = null;
        rentalError = null;
        rentalSuccess = null;
    }

    private void CalculatePrice()
    {
        if (selectedCar != null && endDate > startDate)
        {
            estimatedDays = (endDate - startDate).Days;
            estimatedPrice = selectedCar.PricePerDay * estimatedDays;
        }
        else
        {
            estimatedDays = 0;
            estimatedPrice = 0;
        }
    }

    private async Task SubmitRental()
    {
        if (selectedCar == null) return;

        rentalError = null;
        rentalSuccess = null;
        isSubmitting = true;

        try
        {
            rentalRequest.StartDate = DateOnly.FromDateTime(startDate);
            rentalRequest.EndDate = DateOnly.FromDateTime(endDate);

            if (rentalRequest.EndDate <= rentalRequest.StartDate)
            {
                rentalError = "La date de fin doit être après la date de début";
                isSubmitting = false;
                return;
            }

            var response = await Http.PostAsJsonAsync("api/renter/rent", rentalRequest);

            if (response.IsSuccessStatusCode)
            {
                rentalSuccess = "Réservation confirmée avec succès !";
                await Task.Delay(1500);
                await LoadData();
                CloseRentalModal();
                activeTab = "rentals";
            }
            else
            {
                rentalError = "Une erreur est survenue lors de la réservation";
            }
        }
        catch (Exception ex)
        {
            rentalError = "Une erreur est survenue lors de la réservation";
            Console.WriteLine($"Rental exception: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private int GetRentalDuration(Rental rental)
    {
        return (rental.EndDate.ToDateTime(new TimeOnly(0,0)) - rental.StartDate.ToDateTime(new TimeOnly(0,0))).Days;
    }

    private string GetStatusText(RentalStatus status)
    {
        return status switch
        {
            RentalStatus.Pending => "En attente",
            RentalStatus.Approved => "Approuvée",
            RentalStatus.Rejected => "Refusée",
            _ => "Inconnu"
        };
    }

    private async Task DownloadDocuments(int rentalId)
    {
        try
        {
            var documents = await Http.GetFromJsonAsync<List<RentalDocument>>($"api/renter/rentals/{rentalId}/documents");
            
            if (documents != null && documents.Count > 0)
            {
                foreach (var doc in documents)
                {
                    if (!string.IsNullOrEmpty(doc.FileContent))
                    {
                        var bytes = Convert.FromBase64String(doc.FileContent);
                        var content = System.Text.Encoding.UTF8.GetString(bytes);
                        
                        await JSRuntime.InvokeVoidAsync("downloadFile", doc.FileName, content);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading documents: {ex.Message}");
        }
    }

    [Inject] KeycloakAuthService Auth { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    private async Task HandleLogout()
    {
        if (await JS.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir vous déconnecter ?"))
            await Auth.LogoutAsync();
    }


    private void HandleImageError(ErrorEventArgs e)
    {
        Console.WriteLine($"Image failed to load: {e}");
    }

    private bool IsValidImageUrl(string? url)
    {
        return !string.IsNullOrEmpty(url) && (url.StartsWith("http://") || url.StartsWith("https://") || url.StartsWith("/"));
    }
}

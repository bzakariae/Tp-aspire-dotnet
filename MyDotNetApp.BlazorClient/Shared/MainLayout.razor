@inherits LayoutComponentBase

<div class="app-container">
  

    <main class="main-content">
        @Body
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2025 FuegoCars. Tous droits réservés.</p>
        </div>
    </footer>
</div>

<style>
    .app-container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

   
    .main-content {
        flex: 1;
        padding: 2rem 0;
    }

    .footer {
        background-color: var(--color-surface);
        border-top: 1px solid var(--color-border);
        padding: 2rem 0;
        text-align: center;
        color: var(--color-text-secondary);
    }
</style>
